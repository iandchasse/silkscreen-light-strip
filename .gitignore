# KiCad per-user and cache files
*.kicad_prl
fp-info-cache
*-backups/
~*.lck
*.lck
_autosave-*
*-cache.lib
# generated scratch (regenerate with tools/generate.py and tools/make_outputs.py)
build/
tools/__pycache__/
__pycache__/
*.pyc
# Fabrication Toolkit plugin backups (its order files in production/ are fine to commit)
production/backups/
# MCP server reports written next to the board
*_drc_violations.json
# enclosure copies: build outputs, caches and the originals' old print packages stay on disk, not in git
enclosures/*/out/
enclosures/*/hardware/cache/
enclosures/*/silkscreen-enclosure-rev-*/
enclosures/*/*.zip
enclosures/*/.venv/
enclosures/*/.claude/
# third-party reference downloads used by the enclosures' comparison pages (not ours to redistribute)
enclosures/*/hardware/compare/
enclosures/*/hardware/reference/retrocase/
enclosures/*/hardware/reference/vendor/
# OrcaSlicer rewrites its log in each case project on every slice
enclosures/*/00000.log
# the case showcase's generated data (about 38 MB; rebuild with python -B showcase/gen/bundle.py --strict-page)
docs/showcase/core-*.json
docs/showcase/build-*.json
docs/showcase/extras-*.json
docs/showcase/data-*.json
docs/showcase/models-*.js
